# ==============================================================================
# 🛡️ Nexus Mind Vault — Environment Configuration & Secret Manager Manifest
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# 🔑 Google Gemini AI Intelligence
# Secret Name in GCP Secret Manager: GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here

# ☁️ Firebase Cloud Project
FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# 🔔 Web Push RFC 8292 VAPID Credentials (GCP Secret Manager)
# Secret Name in GCP Secret Manager: VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Secret Name in GCP Secret Manager: VAPID_PRIVATE_KEY
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Secret Name in GCP Secret Manager: VAPID_SUBJECT
VAPID_SUBJECT=mailto:admin@nexusvault.app
