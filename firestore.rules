rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny: Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Authentication Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Strict User-Isolated Domain Rules (ABAC / Owner-Bound)
    match /users/{userId} {
      // User Profile Document
      allow read, write: if isOwner(userId);

      // 1. Zero-Knowledge Encrypted Journal Entries
      match /entries/{entryId} {
        allow read, write: if isOwner(userId);
      }

      // 2. Sealed Time Capsules
      match /timeCapsules/{capsuleId} {
        allow read, write: if isOwner(userId);
      }

      // 3. Legacy Guardian Policies & Heartbeats
      match /guardians/{guardianId} {
        allow read, write: if isOwner(userId);
      }

      // 4. User Vault Configuration & Air-Gap Settings
      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }

      // 5. Semantic Memory Graph Nodes
      match /graphNodes/{nodeId} {
        allow read, write: if isOwner(userId);
      }

      // 6. Cryptographic Audit Events
      match /auditEvents/{eventId} {
        allow read, create: if isOwner(userId);
        allow update, delete: if false;
      }
    }
  }
}
