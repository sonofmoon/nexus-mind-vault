{
  "name": "nexus-mind-vault-functions",
  "private": true,
  "version": "1.0.0",
  "description": "Firebase Cloud Functions (2nd Gen) for Nexus Mind Vault",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "zod": "^4.4.3",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2"
  }
}